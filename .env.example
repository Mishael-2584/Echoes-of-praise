# Safaricom Daraja (M-Pesa) — set these in Netlify Site settings → Environment variables
# Never commit real secrets. All payment traffic runs over HTTPS via Netlify Functions.

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-site.netlify.app/api/mpesa-callback

# Optional: Paybill / Till shown as fallback for manual Lipa na M-Pesa
VITE_MPESA_PAYBILL=
VITE_MPESA_ACCOUNT=ECHOES
VITE_MPESA_TILL=

# Public site URL (used for absolute ticket/donate links)
VITE_SITE_URL=https://your-site.netlify.app
