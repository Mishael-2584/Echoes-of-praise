# Supabase (required for production admin + live CMS data)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Preferred (current): Dashboard → Project Settings → API Keys → Publishable key
# Format: sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Legacy fallback only (anon JWT) — still works until deprecated end of 2026
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Demo admin password when Supabase is not configured (local only)
VITE_ADMIN_DEMO_PASSWORD=echoes-admin

# Safaricom Daraja (M-Pesa) — set these in Netlify Site settings → Environment variables
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://thriving-klepon-4f8cc0.netlify.app/api/mpesa-callback

VITE_MPESA_PAYBILL=
VITE_MPESA_ACCOUNT=ECHOES
VITE_MPESA_TILL=
VITE_SITE_URL=https://thriving-klepon-4f8cc0.netlify.app
