# Supabase (required for production admin + live CMS data)
#
# VITE_SUPABASE_URL = Project URL ONLY (Dashboard → Project Settings → API → Project URL)
# ✅ https://dzvmfexqwyewbqzwypsf.supabase.co
# ❌ https://dzvmfexqwyewbqzwypsf.supabase.co/rest/v1/   ← causes "Invalid path specified"
#
# Do NOT paste the Site URL from Auth settings here.
# Auth Site URL should be your website: https://echoesofpraize.com
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Preferred (current): Dashboard → Project Settings → API Keys → Publishable key
# Format: sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Legacy fallback only (anon JWT) — still works until deprecated end of 2026
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Demo admin password when Supabase is not configured (local only)
VITE_ADMIN_DEMO_PASSWORD=echoes-admin

# Safaricom Daraja (M-Pesa) — set these in Netlify Site settings → Environment variables
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://echoesofpraize.com/api/mpesa-callback

VITE_MPESA_PAYBILL=
VITE_MPESA_ACCOUNT=ECHOES
VITE_MPESA_TILL=
VITE_SITE_URL=https://echoesofpraize.com

# Contact form emails (Netlify Function: contact-submit)
# Optional — without RESEND_API_KEY, submissions still save to Supabase
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Echoes of Praise <hello@echoesofpraize.com>
CONTACT_INBOX=hello@echoesofpraize.com
# Prefer service role on the function so inserts always succeed
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# KCB Buni (M-Pesa Express via KCB). When set, /api/mpesa-stk uses KCB instead of Daraja.
KCB_CONSUMER_KEY=
KCB_CONSUMER_SECRET=
KCB_TILL_NUMBER=8148850
# Optional overrides (defaults are the UAT/sandbox endpoints)
KCB_TOKEN_URL=https://accounts.buni.kcbgroup.com/oauth2/token
KCB_API_BASE=https://uat.buni.kcbgroup.com/mm/api/request/1.0.0
# PEM public key from KCB to verify IPN signatures at /api/kcb-ipn
KCB_IPN_PUBLIC_KEY=
